#!/bin/bash
# keypause: control the Keypause menu bar app from Terminal.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: keypause <command>

  start [time]   Lock the keyboard. Time is seconds, or 90s / 2m (up to 5 minutes).
                 Without a time it uses the duration you chose in the menu.
  stop           Unlock early.
  check          Check for updates.
  help           Show this.
USAGE
}

# "90" -> 90, "90s" -> 90, "2m" -> 120
to_seconds() {
  case "$1" in
    *m) echo $(( ${1%m} * 60 )) ;;
    *s) echo "${1%s}" ;;
    *)  echo "$1" ;;
  esac
}

case "${1:-help}" in
  start)
    if [ -n "${2:-}" ]; then
      if ! [[ "$2" =~ ^[0-9]+[sm]?$ ]]; then echo "keypause: '$2' is not a time. Try 90, 90s or 2m." >&2; exit 2; fi
      open "keypause://start?seconds=$(to_seconds "$2")"
    else
      open "keypause://start"
    fi ;;
  stop)  open "keypause://stop" ;;
  check) open "keypause://check" ;;
  help|-h|--help) usage ;;
  *) echo "keypause: unknown command '$1'" >&2; usage >&2; exit 2 ;;
esac
